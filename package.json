{
  "name": "vinext-file-share-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "react": "latest",
    "react-dom": "latest",
    "react-dropzone": "^20.1.1",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.128.0"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "predev": "npm run cf-typegen",
    "dev": "vinext dev",
    "prebuild": "npm run cf-typegen && npm run typecheck",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate"
  }
}
